{
  "compact": true,
  "identifierNamesGenerator": "hexadecimal",
  "renameGlobals": true,
  "renameProperties": false,
  "deadCodeInjection": false,
  "selfDefending": false,
  "stringArray": true,
  "stringArrayThreshold": 0.75,
  "splitStrings": true,
  "splitStringsChunkLength": 8,
  "transformObjectKeys": false,
  "target": "browser",
  "reservedNames": [
    "^preload$",
    "^setup$",
    "^draw$",
    "^windowResized$",
    "^keyPressed$",
    "^keyReleased$",
    "^keyTyped$",
    "^mousePressed$",
    "^mouseReleased$",
    "^mouseClicked$",
    "^mouseMoved$",
    "^mouseDragged$",
    "^doubleClicked$",
    "^mouseWheel$",
    "^touchStarted$",
    "^touchMoved$",
    "^touchEnded$",
    "^deviceMoved$",
    "^deviceTurned$",
    "^deviceShaken$"
  ]
}
